# 复制本文件为 .env 并填入真实值:cp .env.example .env
# .env 已在 .gitignore 中排除,切勿提交到任何仓库

# MySQL root 密码(不要用生日/学号等可猜值)
MYSQL_PASSWORD=

# JWT 密钥,各生成一串互不相同的强随机值(≥64 字节):
#   openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# dev=控制台打印验证码(仅本地) / prod=走真实 SMTP
APP_MESSAGE_GATEWAY=prod

# 发验证码用的邮箱。password 是 SMTP 授权码,不是邮箱登录密码
MAIL_USERNAME=
MAIL_PASSWORD=
