# 复制本文件为 .env 并填入真实值:cp .env.example .env
# .env 已在 .gitignore 中排除,切勿提交到任何仓库
#
# 本文件是模板:只放变量名与占位说明,绝不放真实值。
# 后端 application-local.yml / application.yml 里的 ${ENV} 占位符读取这些变量。
# 每项标注 [生产必需] / [仅本地]。

# ============================================================
# MySQL
# ============================================================
# 主机/端口/用户(application.yml 默认 127.0.0.1:3306/root,生产按需覆盖)
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
# [生产必需] root 密码,不要用生日/学号等可猜值
MYSQL_PASSWORD=your-db-password

# ============================================================
# Redis
# ============================================================
# 默认 127.0.0.1:6379,无密码。生产按需填
REDIS_HOST=
REDIS_PORT=6379
# [生产必需] 若 Redis 设了 requirepass,这里必须填；否则启动后首次鉴权即报错
REDIS_PASSWORD=
# 逻辑库编号,默认 0
REDIS_DB=0

# ============================================================
# JWT
# ============================================================
# [生产必需] 各生成一串互不相同的强随机值(≥64 字节):
#   openssl rand -base64 64
JWT_ACCESS_SECRET=your-access-secret-at-least-64-bytes
JWT_REFRESH_SECRET=your-refresh-secret-at-least-64-bytes

# ============================================================
# 验证码/邮件网关
# ============================================================
# dev=控制台打印验证码(仅本地) / prod=走真实 SMTP
APP_MESSAGE_GATEWAY=prod
# [生产必需] 发验证码用的邮箱。password 是 SMTP 授权码,不是邮箱登录密码
MAIL_USERNAME=
MAIL_PASSWORD=

# ============================================================
# 校园邮箱域名白名单(F2 校内认证)
# ============================================================
# 逗号分隔。生产注入真实域名;留空则所有域名都拒(1032)——宁可不认证,不可错认证。
# 仅本地开发可放 campus.test,否则认证链路在本机跑不通。
CAMPUS_EMAIL_DOMAIN_WHITELIST=

# ============================================================
# AI 内容机审(LLM)
# ============================================================
# true=真调 LLM / false(缺省)=不真调,机审走 manual 转人工兜底
LLM_ENABLED=
# claude / openai(OpenAI 兼容端点)
LLM_PROVIDER=openai
# [按需] 密钥只放 .env,绝不出现在 application-local.yml 的默认值里
LLM_API_KEY=
# 留空=用 provider 默认端点;也可指兼容/代理端点
LLM_BASE_URL=
LLM_MODEL=
LLM_TIMEOUT_SEC=30

# ============================================================
# 跨域白名单(TD-01/TD-02)
# ============================================================
# [生产必需] 逗号分隔的允许 origin。两者(此处与 localhost-origins 配置)都为空时
# 只放行本机开发端口,任何情况下都不回落到通配符 *。
CORS_ALLOWED_ORIGINS=

# ============================================================
# 文件上传
# ============================================================
# 上传目录。本地默认 ./uploads;容器内挂卷可改绝对路径
UPLOAD_DIR=

# 图片处理（留空走 application.yml 默认值，一般不用改）
# 是否压缩图片 / 长边上限 / 缩略图长边 / WebP 质量(0-100)
UPLOAD_IMAGE_ENABLED=
UPLOAD_IMAGE_MAX_EDGE=
UPLOAD_IMAGE_THUMB_EDGE=
UPLOAD_IMAGE_WEBP_QUALITY=

# ============================================================
# 学校信息（注册与校内认证会用到）
# ============================================================
CAMPUS_SCHOOL_ID=
CAMPUS_SCHOOL_NAME=
# 单个群的人数上限
CAMPUS_GROUP_MAX_MEMBERS=

# ============================================================
# 对象存储 OSS（[可选]）
# ------------------------------------------------------------
# 整组留空 = 不用 OSS，图片/视频写本地磁盘 UPLOAD_DIR，功能完全可用。
# 要开直传才需要填这一组。注意：OSS 直传依赖「已备案域名」的回调，
# 域名备案过审前 OSS_DIRECT_UPLOAD_ENABLED 应保持 false，否则直传会被判失败。
# ============================================================
OSS_DIRECT_UPLOAD_ENABLED=false
OSS_BUCKET=
OSS_REGION=
OSS_ENDPOINT=
# 内网端点（ECS 同区域内网访问，省流量费）
OSS_INTERNAL_ENDPOINT=
OSS_ROLE_ARN=
OSS_STS_ENDPOINT=
# 回调地址必须是已备案域名，形如 https://yousheng8.cn/upload/oss-callback
OSS_CALLBACK_URL=
# [生产必需·仅当开直传] 回调验签密钥，与 OSS 后台配置一致
OSS_CALLBACK_KEY=
# STS 临时凭证（前端直传用）
OSS_STS_ACCESS_KEY_ID=
OSS_STS_ACCESS_KEY_SECRET=
# 读链路签名（缩略图/私有读时用）
OSS_READ_ACCESS_KEY_ID=
OSS_READ_ACCESS_KEY_SECRET=

# ============================================================
# 阿里云邮件推送 DM（[可选]）
# ------------------------------------------------------------
# APP_MESSAGE_GATEWAY=prod 时有两条路：
#   a) 走 SMTP（上方 MAIL_USERNAME / MAIL_PASSWORD）—— 最省事
#   b) 走阿里云 DM —— 需要下面这组；在 ECS 上用 RAM 角色时
#      ALIYUN_DM_CREDENTIAL_TYPE=role 可不填 AccessKey
# ============================================================
ALIYUN_DM_CREDENTIAL_TYPE=
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_REGION_ID=
ALIYUN_DM_ENDPOINT=
ALIYUN_DM_FROM_ADDRESS=
ALIYUN_DM_FROM_ALIAS=
ALIYUN_DM_ADDRESS_TYPE=
ALIYUN_DM_TAG_NAME=
ALIYUN_DM_TEMPLATE_ID=
ALIYUN_DM_SUBJECT=
ALIYUN_DM_ROLE_NAME=
