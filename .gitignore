# Java / Maven
backend/target/
*.class
*.jar

# 前端依赖与构建产物(体积巨大,绝不入库)
node_modules/
frontend/dist/
frontend/node_modules/

# 上传目录(运行时生成)
uploads/

# 日志
*.log

# 本地开发配置(含明文默认凭据,不进仓库;生产走 ${ENV} 环境变量 + application.yml)
backend/src/main/resources/application-local.yml

# 生产环境变量(含数据库密码与 JWT 密钥)
.env

# IDE
.idea/
*.iml
.vscode/

# OS
.DS_Store

# vite 构建中断残留的临时文件
frontend/vite.config.js.timestamp-*.mjs

# 迁移前的库结构备份(过程产物,不入库)
bak/

# 冒烟测试的临时产物(含真实 JWT,绝不入库)
# smoke_tok.txt 是 POST /auth/login 的响应体,里面是能直接用的 access_token
backend/smoke_tok.txt
backend/smoke_*.txt
backend/*_tok.txt

# 冒烟脚本的运行产物(脚本本身在 backend/scripts/ 入库,产物不入库)
backend/scripts/*_tok.txt
backend/scripts/*.log

# 本机端口探测产物:SERVER__PORT 之类的环境变量快照
backend/scripts/env_*.txt

# E2E 验收产物(根目录):内含可直接用的 access/refresh JWT,绝不入库
# .e2e-tokens.json   POST /auth/login-code 的响应体快照
# .e2e-shots/        verify-mobile 的 375px 视口截图
# .e2e-env/          验收用的 node_modules + 临时包
# *.mjs.py 单文件脚本
# 2026-10-23 收紧:单文件名规则挡不住 -fresh/-admin 等新文件,改通配
.e2e-tokens*.json
.e2e-*.json
.e2e-shots/
.e2e-env/
.e2e-patrol.py
.e2e-repro-p0.py
e2e_verify_fixes.py

# 数据库备份(含真实用户数据/哈希/邮箱,绝不入库;已移至仓库外保管)
/backup_*.sql
*.sql.bak

# 设计截图(调试产物,16MB+)
.design-shots/

# scripts/ 下的一次性调试脚本洪泛(正式门禁脚本已追踪,这些是 diag/verify/shot 等调试残留)
