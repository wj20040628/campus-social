# ============================================================
# 生产环境前端变量(vite build --mode production 时加载)
# 与 .env 的差异:生产走独立域名时,把 API/WS 指向线上后端
# 同域部署(前端 Nginx 反代 /api、/ws 到后端)时下面保持默认即可
# ============================================================

# API 前缀
# 同域部署:  /api(由 Nginx 反代到后端 8080)
# 分离部署:  https://api.your-domain.com(需在 .env.production.local 覆盖)
VITE_API_BASE_URL=/api

# WebSocket 前缀
# 留空 = 浏览器自动按 location.protocol(https→wss)+ location.host
# 分离部署且后端不同域时填:wss://api.your-domain.com
VITE_WS_BASE=
